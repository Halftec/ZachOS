# ZachOS package list
# A lean Arch base + a gaming/streaming desktop, not a rescue-disk kitchen sink.

### --- live/boot essentials (archiso needs these regardless of profile) ---
base
linux-firmware
mkinitcpio
mkinitcpio-archiso
syslinux
grub
efibootmgr
memtest86+
memtest86+-efi
squashfs-tools
dosfstools
e2fsprogs
btrfs-progs
exfatprogs
ntfs-3g
parted
gptfdisk
arch-install-scripts
mtools
nano
vim
zsh
sudo
man-db
man-pages
openssh
networkmanager
iwd
dhcpcd
usbutils
pciutils
rsync
reflector
pacman-contrib

### --- kernel: zen, for better desktop/gaming latency ---
linux-zen
linux-zen-headers

### --- GPU drivers: all three vendors, no gaps ---
mesa
lib32-mesa
vulkan-icd-loader
lib32-vulkan-icd-loader
vulkan-radeon
lib32-vulkan-radeon
vulkan-intel
lib32-vulkan-intel
vulkan-nouveau
lib32-vulkan-nouveau
vulkan-tools
xf86-video-amdgpu
xf86-video-ati
nvidia-open-dkms
nvidia-utils
lib32-nvidia-utils
nvidia-settings
dkms

